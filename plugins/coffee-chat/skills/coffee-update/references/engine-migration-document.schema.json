{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffee-chat.dev/schemas/engine-migration-document.schema.json",
  "title": "Coffee Chat Engine Migration Document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "operations"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "json_value": {
      "type": ["string", "number", "boolean", "null", "array", "object"]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "patch"],
      "properties": {
        "kind": { "const": "manifest-json-patch" },
        "path": { "const": "./coffee-chat.json" },
        "patch": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/patch" }
        }
      }
    },
    "patch": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "path", "value"],
          "properties": {
            "op": { "enum": ["add", "replace"] },
            "path": { "const": "/schema_version" },
            "value": { "$ref": "#/$defs/json_value" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "path", "value"],
          "properties": {
            "op": { "const": "test" },
            "path": {
              "enum": [
                "/schema_version",
                "/repository_role",
                "/provenance/engine/repository",
                "/provenance/engine/version",
                "/provenance/engine/release_digest"
              ]
            },
            "value": { "$ref": "#/$defs/json_value" }
          }
        }
      ]
    }
  }
}
