{
  "name": "coffee-chat",
  "version": "2026.08.04",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.5.1",
  "engines": {
    "node": "24.5.0",
    "npm": "11.5.1"
  },
  "scripts": {
    "cc": "node --experimental-strip-types tools/cc.ts",
    "test": "vitest run --maxWorkers=2",
    "test:host": "vitest run --config vitest.host.config.ts --maxWorkers=1",
    "test:all": "npm test && npm run test:host",
    "test:watch": "vitest",
    "test:site": "playwright test",
    "test:acceptance": "vitest run --maxWorkers=1 tests/make-mine-acceptance.test.ts tests/fixture-isolation.test.ts tests/gitleaks-contracts.test.ts tests/skill-evaluations.test.ts",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "ci:policy": "node .github/ci-policy.mjs",
    "merge:policy": "node .github/merge-policy.mjs",
    "gitleaks:scan": "node --experimental-strip-types tools/gitleaks.ts scan --mode repository",
    "site:build": "node --experimental-strip-types tools/site-build.ts",
    "site:check": "node --experimental-strip-types tools/site-build.ts --check"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/cytoscape": "3.31.0",
    "@types/node": "26.1.2",
    "astro": "7.1.6",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cytoscape": "3.34.0",
    "mdast-util-from-markdown": "2.0.2",
    "yaml": "2.9.0"
  }
}
