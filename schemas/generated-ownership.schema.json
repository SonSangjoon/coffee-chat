{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffee-chat.dev/schemas/generated-ownership.schema.json",
  "title": "Coffee Chat Generated Ownership Marker",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "owner", "scope", "owned_files"],
  "properties": {
    "schema_version": { "const": "1.1.0" },
    "owner": { "const": "coffee-chat" },
    "scope": { "enum": ["repository", "plugin-package"] },
    "owned_files": {
      "type": "array",
      "items": { "$ref": "#/$defs/owned_file" }
    },
    "adopted_engine": { "$ref": "#/$defs/adopted_engine" }
  },
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^\\./(?!\\.{1,2}(?:/|$))(?!.*(?:/)\\.{1,2}(?:/|$))(?!.*\\\\)(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "owned_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "repository": {
      "type": "string",
      "pattern": "^https://github\\.com/[a-z0-9.-]+/[a-z0-9._-]+$"
    },
    "calver": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.(?:0[1-9]|1[0-2])\\.(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "adopted_engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "version", "release_digest"],
      "properties": {
        "repository": { "$ref": "#/$defs/repository" },
        "version": { "$ref": "#/$defs/calver" },
        "release_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
