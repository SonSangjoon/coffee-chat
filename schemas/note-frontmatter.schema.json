{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffee-chat.dev/schemas/note-frontmatter.schema.json",
  "title": "Coffee Chat Note Frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "temporal_coverage", "recorded_on", "sources"],
  "properties": {
    "id": { "$ref": "#/$defs/uuid_v4" },
    "title": { "type": "string", "minLength": 1 },
    "temporal_coverage": { "$ref": "#/$defs/temporal_coverage" },
    "recorded_on": { "$ref": "#/$defs/date" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/citation" }
    },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/uuid_v4" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "uuid_v4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "temporal_coverage": {
      "type": "string",
      "pattern": "^[0-9]{4}(?:-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12][0-9]|3[01]))?)?(?:/[0-9]{4}(?:-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12][0-9]|3[01]))?)?)?$"
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "title"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "title": { "type": "string", "minLength": 1 },
        "published_on": { "$ref": "#/$defs/partial_date" },
        "accessed_on": { "$ref": "#/$defs/date" }
      }
    },
    "partial_date": {
      "type": "string",
      "pattern": "^[0-9]{4}(?:-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12][0-9]|3[01]))?)?$"
    }
  }
}
