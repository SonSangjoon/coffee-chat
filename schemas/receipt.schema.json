{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffee-chat.dev/schemas/receipt.schema.json",
  "title": "Coffee Chat Apply Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_digest",
    "status",
    "changed_paths",
    "validation",
    "target_fingerprint"
  ],
  "properties": {
    "schema_version": { "$ref": "#/$defs/semver" },
    "candidate_digest": { "$ref": "#/$defs/digest" },
    "status": {
      "enum": ["applied", "partial_local_result", "approval_invalidated"]
    },
    "changed_paths": {
      "type": "array",
      "items": { "$ref": "#/$defs/repository_path" },
      "uniqueItems": true
    },
    "validation": { "$ref": "#/$defs/validation" },
    "target_fingerprint": { "$ref": "#/$defs/target_fingerprint" },
    "provenance": { "$ref": "#/$defs/instance_provenance" },
    "template_observation": { "$ref": "#/$defs/template_observation" },
    "invalidation_code": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "setup_effects": {
      "type": "array",
      "items": { "$ref": "#/$defs/setup_result" },
      "uniqueItems": true
    },
    "setup_failure": { "type": "string" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "approval_invalidated" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "changed_paths": { "type": "array", "maxItems": 0 },
          "validation": {
            "type": "object",
            "properties": { "status": { "const": "not_run" } },
            "required": ["status"]
          },
          "invalidation_code": true,
          "setup_effects": false,
          "setup_failure": false
        },
        "required": ["invalidation_code"]
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "applied" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "validation": {
            "type": "object",
            "properties": { "status": { "const": "passed" } },
            "required": ["status"]
          },
          "invalidation_code": false,
          "setup_effects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "status": { "const": "applied" } },
              "required": ["status"]
            }
          },
          "setup_failure": false
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "partial_local_result" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "changed_paths": { "type": "array", "minItems": 1 },
          "validation": {
            "type": "object",
            "properties": { "status": { "const": "passed" } },
            "required": ["status"]
          },
          "invalidation_code": false,
          "setup_effects": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "contains": {
              "type": "object",
              "properties": { "status": { "const": "failed" } },
              "required": ["status"]
            }
          },
          "setup_failure": true
        },
        "required": ["setup_effects", "setup_failure"]
      }
    }
  ],
  "$defs": {
    "instance_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "created_from"],
      "properties": {
        "engine": { "$ref": "#/$defs/engine_provenance" },
        "created_from": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "template_repository"],
          "properties": {
            "method": { "const": "github-template" },
            "template_repository": { "$ref": "#/$defs/github_repository" }
          }
        }
      }
    },
    "engine_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "version", "source_commit", "release_digest"],
      "properties": {
        "repository": { "$ref": "#/$defs/github_repository" },
        "version": { "$ref": "#/$defs/calver" },
        "source_commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "release_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "github_repository": {
      "type": "string",
      "pattern": "^https://github\\.com/[a-z0-9.-]+/[a-z0-9._-]+$"
    },
    "object_id": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "decimal_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "template_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_repository_id",
        "source_repository",
        "source_is_template",
        "source_visibility",
        "source_default_branch",
        "source_default_commit",
        "source_default_tree",
        "source_release_ref",
        "source_release_commit",
        "source_release_tree",
        "release_digest",
        "template_surface_digest",
        "target_repository_id",
        "target_repository",
        "target_description",
        "template_repository",
        "target_visibility",
        "target_default_branch",
        "target_initial_commit",
        "target_initial_tree"
      ],
      "properties": {
        "source_repository_id": { "$ref": "#/$defs/decimal_id" },
        "source_repository": { "$ref": "#/$defs/github_repository" },
        "source_is_template": { "const": true },
        "source_visibility": { "const": "public" },
        "source_default_branch": { "type": "string", "minLength": 1 },
        "source_default_commit": { "$ref": "#/$defs/object_id" },
        "source_default_tree": { "$ref": "#/$defs/object_id" },
        "source_release_ref": { "type": "string", "minLength": 1 },
        "source_release_commit": { "$ref": "#/$defs/object_id" },
        "source_release_tree": { "$ref": "#/$defs/object_id" },
        "release_digest": { "$ref": "#/$defs/digest" },
        "template_surface_digest": { "$ref": "#/$defs/digest" },
        "target_repository_id": { "$ref": "#/$defs/decimal_id" },
        "target_repository": { "$ref": "#/$defs/github_repository" },
        "target_description": { "type": "string" },
        "template_repository": { "$ref": "#/$defs/github_repository" },
        "target_visibility": { "const": "public" },
        "target_default_branch": { "type": "string", "minLength": 1 },
        "target_initial_commit": { "$ref": "#/$defs/object_id" },
        "target_initial_tree": { "$ref": "#/$defs/object_id" }
      }
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "calver": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.(?:0[1-9]|1[0-2])\\.(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "repository_path": {
      "type": "string",
      "pattern": "^\\./(?!.*(?:^|/)\\.\\.(?:/|$))(?:[A-Za-z0-9._\\-\\[\\]]+/)*[A-Za-z0-9._\\-\\[\\]]+/?$"
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": { "status": { "enum": ["passed", "not_run"] } }
    },
    "absolute_path": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))/(?:[^/\\u0000]+/)*[^/\\u0000]+$"
    },
    "decimal_integer": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)$"
    },
    "target_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_common_dir",
        "origin_url",
        "base_commit",
        "pre_conversion_manifest_digest"
      ],
      "properties": {
        "git_common_dir": {
          "type": "object",
          "additionalProperties": false,
          "required": ["real_path", "device", "inode"],
          "properties": {
            "real_path": { "$ref": "#/$defs/absolute_path" },
            "device": { "$ref": "#/$defs/decimal_integer" },
            "inode": { "$ref": "#/$defs/decimal_integer" }
          }
        },
        "origin_url": {
          "type": "string",
          "pattern": "^https://github\\.com/[a-z0-9.-]+/[a-z0-9._-]+$"
        },
        "base_commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "pre_conversion_manifest_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "setup_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect", "target_path", "status"],
      "properties": {
        "effect": { "const": "install-pre-commit" },
        "target_path": { "type": "string", "pattern": "^/" },
        "status": { "enum": ["applied", "failed"] }
      }
    }
  }
}
