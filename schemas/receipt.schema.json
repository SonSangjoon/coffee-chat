{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffee-chat.dev/schemas/receipt.schema.json",
  "title": "Coffee Chat Apply Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_digest",
    "status",
    "changed_paths",
    "validation",
    "target_fingerprint"
  ],
  "properties": {
    "schema_version": { "$ref": "#/$defs/semver" },
    "candidate_digest": { "$ref": "#/$defs/digest" },
    "status": {
      "enum": ["applied", "partial_local_result", "approval_invalidated"]
    },
    "changed_paths": {
      "type": "array",
      "items": { "$ref": "#/$defs/repository_path" },
      "uniqueItems": true
    },
    "validation": { "$ref": "#/$defs/validation" },
    "target_fingerprint": { "$ref": "#/$defs/target_fingerprint" },
    "invalidation_code": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "setup_effects": {
      "type": "array",
      "items": { "$ref": "#/$defs/setup_result" },
      "uniqueItems": true
    },
    "setup_failure": { "type": "string" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "approval_invalidated" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "changed_paths": { "type": "array", "maxItems": 0 },
          "validation": {
            "type": "object",
            "properties": { "status": { "const": "not_run" } },
            "required": ["status"]
          },
          "invalidation_code": true,
          "setup_effects": false,
          "setup_failure": false
        },
        "required": ["invalidation_code"]
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "applied" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "validation": {
            "type": "object",
            "properties": { "status": { "const": "passed" } },
            "required": ["status"]
          },
          "invalidation_code": false,
          "setup_effects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "status": { "const": "applied" } },
              "required": ["status"]
            }
          },
          "setup_failure": false
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "partial_local_result" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "changed_paths": { "type": "array", "minItems": 1 },
          "validation": {
            "type": "object",
            "properties": { "status": { "const": "passed" } },
            "required": ["status"]
          },
          "invalidation_code": false,
          "setup_effects": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "contains": {
              "type": "object",
              "properties": { "status": { "const": "failed" } },
              "required": ["status"]
            }
          },
          "setup_failure": true
        },
        "required": ["setup_effects", "setup_failure"]
      }
    }
  ],
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "repository_path": {
      "type": "string",
      "pattern": "^\\./(?!.*(?:^|/)\\.\\.(?:/|$))(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+/?$"
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": { "status": { "enum": ["passed", "not_run"] } }
    },
    "absolute_path": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))/(?:[^/\\u0000]+/)*[^/\\u0000]+$"
    },
    "decimal_integer": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)$"
    },
    "target_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_common_dir",
        "origin_url",
        "base_commit",
        "pre_conversion_manifest_digest"
      ],
      "properties": {
        "git_common_dir": {
          "type": "object",
          "additionalProperties": false,
          "required": ["real_path", "device", "inode"],
          "properties": {
            "real_path": { "$ref": "#/$defs/absolute_path" },
            "device": { "$ref": "#/$defs/decimal_integer" },
            "inode": { "$ref": "#/$defs/decimal_integer" }
          }
        },
        "origin_url": {
          "type": "string",
          "pattern": "^https://github\\.com/[a-z0-9.-]+/[a-z0-9._-]+$"
        },
        "base_commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "pre_conversion_manifest_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "setup_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect", "target_path", "status"],
      "properties": {
        "effect": { "const": "install-pre-commit" },
        "target_path": { "type": "string", "pattern": "^/" },
        "status": { "enum": ["applied", "failed"] }
      }
    }
  }
}
