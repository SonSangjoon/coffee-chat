{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffee-chat.dev/schemas/preview.schema.json",
  "title": "Coffee Chat Public-content Preview",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_digest",
    "candidate_directory",
    "mode",
    "base_commit",
    "target_fingerprint",
    "current_repository_role",
    "proposed_repository_role",
    "actual_origin_url",
    "proposed_time_zone",
    "marketplace_name",
    "time_zone",
    "frozen_date",
    "affected_paths",
    "output_hashes",
    "knowledge_digest",
    "canonical_diff",
    "worktree",
    "notes",
    "entities",
    "source_observations",
    "setup_effects",
    "unresolved_source_limitations",
    "privacy_warnings",
    "validation"
  ],
  "properties": {
    "schema_version": { "$ref": "#/$defs/semver" },
    "candidate_digest": { "$ref": "#/$defs/digest" },
    "candidate_directory": { "const": "." },
    "mode": { "enum": ["make-mine", "contribute", "update"] },
    "base_commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "target_fingerprint": { "$ref": "#/$defs/target_fingerprint" },
    "current_repository_role": { "enum": ["engine", "instance"] },
    "proposed_repository_role": { "const": "instance" },
    "actual_origin_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://github\\.com/[a-z0-9.-]+/[a-z0-9._-]+$"
    },
    "proposed_time_zone": { "type": "string", "minLength": 1 },
    "marketplace_name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-marketplace$"
    },
    "provenance": { "$ref": "#/$defs/instance_provenance" },
    "template_observation": { "$ref": "#/$defs/template_observation" },
    "content_notice": { "type": "string", "minLength": 1 },
    "time_zone": { "type": "string" },
    "frozen_date": { "$ref": "#/$defs/date" },
    "affected_paths": {
      "type": "array",
      "items": { "$ref": "#/$defs/repository_path" },
      "uniqueItems": true
    },
    "output_hashes": {
      "type": "array",
      "items": { "$ref": "#/$defs/path_digest" }
    },
    "knowledge_digest": { "$ref": "#/$defs/digest" },
    "canonical_diff": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "change"],
        "properties": {
          "path": { "$ref": "#/$defs/repository_path" },
          "change": { "enum": ["create", "update", "delete"] },
          "before_digest": { "$ref": "#/$defs/digest" },
          "after_digest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "worktree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "changes"],
      "properties": {
        "fingerprint": { "$ref": "#/$defs/digest" },
        "changes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "temporal_coverage",
          "recorded_on",
          "sources",
          "entities",
          "body"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/uuid_v4" },
          "title": { "type": "string" },
          "temporal_coverage": { "type": "string" },
          "recorded_on": { "$ref": "#/$defs/date" },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "title"],
              "properties": {
                "url": { "type": "string" },
                "title": { "type": "string" },
                "published_on": { "type": "string" },
                "accessed_on": { "$ref": "#/$defs/date" }
              }
            }
          },
          "entities": {
            "type": "array",
            "items": { "$ref": "#/$defs/uuid_v4" },
            "uniqueItems": true
          },
          "body": { "type": "string" },
          "change": { "enum": ["create", "correct", "unchanged"] }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/uuid_v4" },
          "label": { "type": "string" },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "kind": { "type": "string" },
          "same_as": { "type": "array", "items": { "type": "string" } },
          "change": {
            "enum": ["create", "update", "retire", "unchanged"]
          }
        }
      }
    },
    "source_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["note_id", "url", "title", "retrieval_status"],
        "properties": {
          "note_id": { "$ref": "#/$defs/uuid_v4" },
          "url": { "type": "string" },
          "title": { "type": "string" },
          "published_on": { "type": "string" },
          "accessed_on": { "$ref": "#/$defs/date" },
          "retrieval_status": { "enum": ["succeeded", "unavailable"] },
          "access_limitation": { "type": "string" }
        }
      }
    },
    "setup_effects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["effect", "target_path", "target_fingerprint"],
        "properties": {
          "effect": { "const": "install-pre-commit" },
          "target_path": { "type": "string", "pattern": "^/" },
          "target_fingerprint": { "type": "object" }
        }
      }
    },
    "unresolved_source_limitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "privacy_warnings": { "type": "array", "items": { "type": "string" } },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": { "status": { "const": "passed" } }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": { "mode": { "const": "make-mine" } }
      },
      "then": {
        "type": "object",
        "properties": {
          "content_notice": true,
          "provenance": true,
          "template_observation": true
        },
        "required": ["content_notice", "provenance", "template_observation"]
      },
      "else": {
        "type": "object",
        "properties": {
          "content_notice": false,
          "provenance": false,
          "template_observation": false
        }
      }
    }
  ],
  "$defs": {
    "preview_data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_directory",
        "mode",
        "base_commit",
        "target_fingerprint",
        "current_repository_role",
        "proposed_repository_role",
        "actual_origin_url",
        "proposed_time_zone",
        "marketplace_name",
        "time_zone",
        "frozen_date",
        "affected_paths",
        "output_hashes",
        "knowledge_digest",
        "canonical_diff",
        "worktree",
        "notes",
        "entities",
        "source_observations",
        "setup_effects",
        "unresolved_source_limitations",
        "privacy_warnings",
        "validation"
      ],
      "properties": {
        "candidate_directory": {
          "$ref": "#/properties/candidate_directory"
        },
        "mode": { "$ref": "#/properties/mode" },
        "base_commit": { "$ref": "#/properties/base_commit" },
        "target_fingerprint": {
          "$ref": "#/properties/target_fingerprint"
        },
        "current_repository_role": {
          "$ref": "#/properties/current_repository_role"
        },
        "proposed_repository_role": {
          "$ref": "#/properties/proposed_repository_role"
        },
        "actual_origin_url": {
          "$ref": "#/properties/actual_origin_url"
        },
        "proposed_time_zone": {
          "$ref": "#/properties/proposed_time_zone"
        },
        "marketplace_name": { "$ref": "#/properties/marketplace_name" },
        "provenance": { "$ref": "#/properties/provenance" },
        "template_observation": { "$ref": "#/properties/template_observation" },
        "content_notice": { "$ref": "#/properties/content_notice" },
        "time_zone": { "$ref": "#/properties/time_zone" },
        "frozen_date": { "$ref": "#/properties/frozen_date" },
        "affected_paths": { "$ref": "#/properties/affected_paths" },
        "output_hashes": { "$ref": "#/properties/output_hashes" },
        "knowledge_digest": { "$ref": "#/properties/knowledge_digest" },
        "canonical_diff": { "$ref": "#/properties/canonical_diff" },
        "worktree": { "$ref": "#/properties/worktree" },
        "notes": { "$ref": "#/properties/notes" },
        "entities": { "$ref": "#/properties/entities" },
        "source_observations": {
          "$ref": "#/properties/source_observations"
        },
        "setup_effects": { "$ref": "#/properties/setup_effects" },
        "unresolved_source_limitations": {
          "$ref": "#/properties/unresolved_source_limitations"
        },
        "privacy_warnings": { "$ref": "#/properties/privacy_warnings" },
        "validation": { "$ref": "#/properties/validation" }
      },
      "allOf": [{ "$ref": "#/allOf/0" }]
    },
    "instance_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "created_from"],
      "properties": {
        "engine": { "$ref": "#/$defs/engine_provenance" },
        "created_from": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "template_repository"],
          "properties": {
            "method": { "const": "github-template" },
            "template_repository": { "$ref": "#/$defs/github_repository" }
          }
        }
      }
    },
    "engine_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "version", "source_commit", "release_digest"],
      "properties": {
        "repository": { "$ref": "#/$defs/github_repository" },
        "version": { "$ref": "#/$defs/calver" },
        "source_commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "release_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "github_repository": {
      "type": "string",
      "pattern": "^https://github\\.com/[a-z0-9.-]+/[a-z0-9._-]+$"
    },
    "object_id": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "decimal_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "template_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_repository_id",
        "source_repository",
        "source_is_template",
        "source_visibility",
        "source_default_branch",
        "source_default_commit",
        "source_default_tree",
        "source_release_ref",
        "source_release_commit",
        "source_release_tree",
        "release_digest",
        "template_surface_digest",
        "target_repository_id",
        "target_repository",
        "target_description",
        "template_repository",
        "target_visibility",
        "target_default_branch",
        "target_initial_commit",
        "target_initial_tree"
      ],
      "properties": {
        "source_repository_id": { "$ref": "#/$defs/decimal_id" },
        "source_repository": { "$ref": "#/$defs/github_repository" },
        "source_is_template": { "const": true },
        "source_visibility": { "const": "public" },
        "source_default_branch": { "type": "string", "minLength": 1 },
        "source_default_commit": { "$ref": "#/$defs/object_id" },
        "source_default_tree": { "$ref": "#/$defs/object_id" },
        "source_release_ref": { "type": "string", "minLength": 1 },
        "source_release_commit": { "$ref": "#/$defs/object_id" },
        "source_release_tree": { "$ref": "#/$defs/object_id" },
        "release_digest": { "$ref": "#/$defs/digest" },
        "template_surface_digest": { "$ref": "#/$defs/digest" },
        "target_repository_id": { "$ref": "#/$defs/decimal_id" },
        "target_repository": { "$ref": "#/$defs/github_repository" },
        "target_description": { "type": "string" },
        "template_repository": { "$ref": "#/$defs/github_repository" },
        "target_visibility": { "const": "public" },
        "target_default_branch": { "type": "string", "minLength": 1 },
        "target_initial_commit": { "$ref": "#/$defs/object_id" },
        "target_initial_tree": { "$ref": "#/$defs/object_id" }
      }
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "calver": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.(?:0[1-9]|1[0-2])\\.(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "uuid_v4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "absolute_path": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))/(?:[^/\\u0000]+/)*[^/\\u0000]+$"
    },
    "decimal_integer": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)$"
    },
    "target_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_common_dir",
        "origin_url",
        "base_commit",
        "pre_conversion_manifest_digest"
      ],
      "properties": {
        "git_common_dir": {
          "type": "object",
          "additionalProperties": false,
          "required": ["real_path", "device", "inode"],
          "properties": {
            "real_path": { "$ref": "#/$defs/absolute_path" },
            "device": { "$ref": "#/$defs/decimal_integer" },
            "inode": { "$ref": "#/$defs/decimal_integer" }
          }
        },
        "origin_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/[a-z0-9.-]+/[a-z0-9._-]+$"
        },
        "base_commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "pre_conversion_manifest_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "repository_path": {
      "type": "string",
      "pattern": "^\\./(?!.*(?:^|/)\\.\\.(?:/|$))(?:[A-Za-z0-9._\\-\\[\\]]+/)*[A-Za-z0-9._\\-\\[\\]]+/?$"
    },
    "path_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "$ref": "#/$defs/repository_path" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
