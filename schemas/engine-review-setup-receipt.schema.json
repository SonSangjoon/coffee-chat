{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffee-chat.dev/schemas/engine-review-setup-receipt.schema.json",
  "title": "Coffee Chat engine review setup receipt",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "setup_digest",
        "status",
        "source",
        "checkout_path",
        "observations",
        "command_results",
        "completed_effects"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "setup_digest": { "$ref": "#/$defs/digest" },
        "status": { "const": "completed" },
        "source": { "$ref": "#/$defs/source" },
        "checkout_path": { "$ref": "#/$defs/absolute_path" },
        "observations": { "$ref": "#/$defs/observations" },
        "command_results": { "$ref": "#/$defs/command_results" },
        "completed_effects": { "const": ["git-checkout", "npm-ci"] }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "setup_digest",
        "status",
        "reason_codes",
        "completed_effects"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "setup_digest": { "$ref": "#/$defs/digest" },
        "status": { "const": "invalidated" },
        "reason_codes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "completed_effects": { "const": [] }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "setup_digest",
        "status",
        "completed_effects",
        "command_results",
        "recovery"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "setup_digest": { "$ref": "#/$defs/digest" },
        "status": { "const": "partial_setup_result" },
        "completed_effects": { "enum": [[], ["git-checkout"]] },
        "checkout_path": { "$ref": "#/$defs/absolute_path" },
        "command_results": {
          "type": "array",
          "items": { "$ref": "#/$defs/command_result" }
        },
        "recovery": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "repository": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9.-]+/[A-Za-z0-9._-]+$"
    },
    "absolute_path": {
      "type": "string",
      "pattern": "^/(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?:[^/\\u0000]+/)*[^/\\u0000]+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "source_ref",
        "source_commit",
        "release_digest",
        "registry_digest",
        "package_lock_digest"
      ],
      "properties": {
        "repository": { "$ref": "#/$defs/repository" },
        "source_ref": { "type": "string", "pattern": "^refs/tags/v[^/]+$" },
        "source_commit": { "$ref": "#/$defs/commit" },
        "release_digest": { "$ref": "#/$defs/digest" },
        "registry_digest": { "$ref": "#/$defs/digest" },
        "package_lock_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "command": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "maxItems": 32
    },
    "command_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exit_code", "stdout_digest", "stderr_digest"],
      "properties": {
        "command": { "$ref": "#/$defs/command" },
        "exit_code": { "type": "integer", "minimum": 0 },
        "stdout_digest": { "$ref": "#/$defs/digest" },
        "stderr_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "command_results": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/command_result" },
        { "$ref": "#/$defs/command_result" }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_commit",
        "source_tree",
        "release_digest",
        "registry_digest",
        "package_lock_digest",
        "node_version",
        "npm_version",
        "registry_host",
        "writes"
      ],
      "properties": {
        "source_commit": { "$ref": "#/$defs/commit" },
        "source_tree": { "$ref": "#/$defs/commit" },
        "release_digest": { "$ref": "#/$defs/digest" },
        "registry_digest": { "$ref": "#/$defs/digest" },
        "package_lock_digest": { "$ref": "#/$defs/digest" },
        "node_version": { "const": "24.5.0" },
        "npm_version": { "const": "11.5.1" },
        "registry_host": { "type": "string", "minLength": 1 },
        "writes": { "const": ["node_modules/**"] }
      }
    }
  }
}
