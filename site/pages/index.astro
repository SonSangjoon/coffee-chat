---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteHref } from "../lib/build-context.ts";
import { siteModel } from "../lib/site-context.ts";

const model = siteModel;
const data = model.role === "engine" ? model.documentation : model.graph;
const title =
  model.role === "engine"
    ? "Coffee Chat — Origins, Beans, and Coffee"
    : `Coffee Chat with ${model.manifest.profile.short_name}`;
const description =
  model.role === "engine"
    ? "A neutral engine for Harvesting Origins, Roasting Beans, and Brewing Coffee."
    : `Explore ${model.manifest.profile.display_name}'s public, dated Green Beans.`;
---

<BaseLayout {model} {title} {description}>
  {
    model.role === "engine" ? (
      <>
        <section class="hero">
          <p class="eyebrow">Neutral engine / 중립 엔진</p>
          <h1>The same Origin is not the same Roast.</h1>
          <p class="lede">
            Coffee Chat stores what someone noticed in a specific Origin, what
            they treated as important, and why. A Green Bean is the durable record;
            Taste is the Bean-shaped pattern that becomes visible across Roasts. / 같은
            Origin이라도 같은 관점이 되지는 않습니다. Coffee Chat은 누군가 특정
            Origin에서 무엇을 보았고 무엇을 중요하게 여겼는지, 왜 그랬는지를
            저장합니다. Green Bean이 지속 기록이고 Taste는 기록 사이에서
            드러나는 패턴입니다.
          </p>
          <div class="hero-actions">
            <a
              class="button"
              href={model.manifest.repository.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              Create yours / 나만의 인스턴스 만들기
            </a>
            <a class="button secondary" href="#contract">
              Read the contract / 설계 계약 보기
            </a>
          </div>
        </section>
        <section class="section" id="contract">
          <p class="eyebrow">Core contract / Core 계약</p>
          <h2>Store the annotation. Retrieve the context.</h2>
          <div class="card-grid">
            <article class="card">
              <h3>Origin</h3>
              <p>
                Keep the exact public information being considered and its
                Citation metadata. Coffee Chat does not pretend a URL is the
                author's view.
              </p>
            </article>
            <article class="card">
              <h3>Green Bean</h3>
              <p>
                Record what the author noticed, valued, and left Unknown. The
                author approves the dated Green Bean before it becomes durable.
              </p>
            </article>
            <article class="card">
              <h3>Taste projection</h3>
              <p>
                Let a pattern emerge across annotations. Do not create a
                separate global Taste object or an executable rule.
              </p>
            </article>
          </div>
        </section>
        <section class="section">
          <p class="eyebrow">Runtime path / Runtime 경로</p>
          <h2>One record, two bounded uses.</h2>
          <div class="card-grid">
            <article class="card">
              <h3>Coffee Chat</h3>
              <p>
                A verified public instance answers a person's question from
                relevant Green Beans, Origins, dates, and Unknown.
              </p>
            </article>
            <article class="card">
              <h3>Coffee Pairing</h3>
              <p>
                A named external task can receive contextual retrieval and
                agent-conditioned interpretation without persisting the task
                result.
              </p>
            </article>
            <article class="card">
              <h3>Context delivery</h3>
              <p>
                Every response keeps Authored, Sourced, Inferred, and Unknown
                distinct so a person can inspect the boundary.
              </p>
            </article>
          </div>
        </section>
        <section class="section">
          <p class="eyebrow">Start here / 여기서 시작</p>
          <h2>This engine has no default person or Taste.</h2>
          <p class="lede">
            There is no personal record or person-specific demo at this engine
            URL. Choose one explicit next step: Create yours, Install engine
            plugin, or Contribute to engine. / 이 엔진 URL에는 개인 기록이나 특정
            인물 데모가 없습니다. Create yours·Install engine plugin·Contribute
            to engine 중 하나를 명시적으로 선택하세요.
          </p>
        </section>
      </>
    ) : (
      <>
        <section class="hero">
          <p class="eyebrow">Public instance / 공개 인스턴스</p>
          <h1>Coffee Chat with {model.manifest.profile.short_name}</h1>
          <p class="lede">
            Explore public Origins and dated Green Beans. Ask what was noticed,
            what mattered, and why—then keep
            the answer tied to its evidence. / 공개 Source와 날짜가 있는
            Green Bean을 살펴보세요. 무엇을 보았고
            무엇이 중요했는지, 왜 그랬는지 근거와 함께 질문할 수 있습니다.
          </p>
          {
            model.graph.engine_provenance && (
              <p class="eyebrow">
                Built with{" "}
                <a
                  href={model.graph.engine_provenance.repository}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Coffee Chat
                </a>{" "}
                · v{model.graph.engine_provenance.version}
              </p>
            )
          }
          <div class="hero-actions">
            <a class="button" href={siteHref(data.base_path, "timeline/")}>
              Browse timeline / 타임라인 보기
            </a>
            <a class="button secondary" href={siteHref(data.base_path, "graph/")}>
              Browse provenance graph / 근거 그래프 보기
            </a>
          </div>
        </section>
        <section class="section">
          <p class="eyebrow">What you can inspect / 살펴볼 수 있는 것</p>
          <h2>Follow the Green Bean back to its Origin.</h2>
          <div class="card-grid">
            <article class="card">
              <h3>Green Beans</h3>
              <p>
                Read the author's dated annotations and the perspective time
                they describe.
              </p>
            </article>
            <article class="card">
              <h3>Origins</h3>
              <p>
                Open the exact public URLs and inspect what each Green Bean observed
                from them.
              </p>
            </article>
            <article class="card">
              <h3>Taste over time</h3>
              <p>
                Compare annotations across time. A pattern is not a personality
                profile and does not replace asking the person.
              </p>
            </article>
          </div>
        </section>
        <section class="section">
          <p class="eyebrow">AI interpretation disclosure / AI 해석 고지</p>
          <h2>The record is durable. The answer is bounded.</h2>
          <p class="lede">
            A response is an agent-conditioned interpretation generated at
            request time from selected public records. It may be incomplete and
            is not the author speaking live. It is not written back to Git. /
            응답은 선택된 공개 기록에서 요청 시점에 생성된
            agent-conditioned interpretation입니다. 불완전할 수 있으며 작성자가
            실시간으로 말하는 것이 아닙니다. Git에 다시 저장되지 않습니다.
          </p>
          <ul class="tag-list" aria-label="Public record counts / 공개 기록 개수">
            <li class="tag">{data.notes.length} Notes</li>
            <li class="tag">{data.entities.length} Entities</li>
            <li class="tag">{data.sources.length} Sources</li>
          </ul>
        </section>
      </>
    )
  }
</BaseLayout>
