---
import GraphView from "../components/GraphView.astro";
import TemporalFilters from "../components/TemporalFilters.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteModel } from "../lib/site-context.ts";

const model = siteModel;
const graph = model.role === "instance" ? model.graph : undefined;
const pageTitle =
  model.role === "instance"
    ? `Graph — Coffee Chat with ${model.manifest.profile.short_name}`
    : "Graph — Coffee Chat";
---

<BaseLayout
  {model}
  title={pageTitle}
  description="Explore Green Beans, Origins, Entities, and the explicit provenance between them."
>
  {
    graph && (
      <>
        <section class="hero">
          <p class="eyebrow">Provenance graph / 근거 그래프</p>
          <h1>Trace every Green Bean back to its Origin.</h1>
          <p class="lede">
            Green Beans cite Origins, mention neutral Entities, and link to other Green Beans.
            The graph stores provenance for authored POVs; it does not store a
            global Taste object or task answer. /
            기록은 Origin을 인용하고 중립적인 Entity를 언급하며 다른 Green Bean과
            연결됩니다. 그래프는 Green Bean의 근거를 저장하고 전역 Taste
            객체나 작업 답변은 저장하지 않습니다.
          </p>
        </section>
        <TemporalFilters basePath={graph.base_path} activeView="graph" />
        <section class="section" aria-labelledby="graph-view-title">
          <p class="eyebrow">Explicit provenance / 명시적 근거</p>
          <h2 id="graph-view-title">Green Beans, Origins, Entities</h2>
          <GraphView {graph} />
        </section>
      </>
    )
  }
</BaseLayout>
