---
import KnowledgeList from "../components/KnowledgeList.astro";
import TemporalFilters from "../components/TemporalFilters.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteModel } from "../lib/site-context.ts";

const model = siteModel;
const graph = model.role === "instance" ? model.graph : undefined;
const pageTitle =
  model.role === "instance"
    ? `Timeline — Coffee Chat with ${model.manifest.profile.short_name}`
    : "Timeline — Coffee Chat";
---

<BaseLayout
  {model}
  title={pageTitle}
  description="Browse dated Green Beans by POV time and first-recorded cutoff."
>
  {
    graph && (
      <>
        <section class="hero">
          <p class="eyebrow">Timeline / 타임라인</p>
          <h1>Annotations change. The record keeps the sequence.</h1>
          <p class="lede">
            Green Bean time marks when a POV applies. Recorded date marks
            when this public Green Bean first entered the graph. / Green Bean이
            관점이 적용되는 시점을, 기록일은 이 공개 Green Bean이 그래프에 처음
            들어온 날짜를 뜻합니다.
          </p>
        </section>
        <TemporalFilters basePath={graph.base_path} activeView="timeline" />
        <section class="section" aria-labelledby="timeline-records">
          <p class="eyebrow">Current corrected corpus / 현재 정정된 코퍼스</p>
          <h2 id="timeline-records">Dated Green Beans / 날짜별 기록</h2>
          <KnowledgeList {graph} />
        </section>
      </>
    )
  }
</BaseLayout>
